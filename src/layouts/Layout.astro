---
import "../styles/global.css";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
}

const { title = "Círculo de Quintas" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Círculo de quintas interactivo con los grados de cada tonalidad." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-900 text-slate-100 antialiased">
    <Nav />
    <slot />
  </body>
</html>
