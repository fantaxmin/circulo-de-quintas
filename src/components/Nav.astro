---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/escalas", label: "Escalas" },
  { href: "/acordes", label: "Acordes" },
  { href: "/conceptos", label: "Conceptos" },
];
---

<nav class="sticky top-0 z-40 border-b border-border bg-surface backdrop-blur">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between px-4 py-3">
    <a href="/" class="flex shrink-0 items-center gap-2 font-bold text-text">
      <span class="text-accent">◍</span> Círculo de Quintas
    </a>
    <ul class="flex w-full min-w-0 items-center gap-1 overflow-x-auto pb-1 text-sm sm:w-auto sm:pb-0">
      {
        links.map((l) => {
          const active = path === l.href;
          return (
            <li class="shrink-0">
              <a
                href={l.href}
                class={`block whitespace-nowrap rounded-lg px-3 py-2 transition ${
                  active
                    ? "bg-accent/15 font-semibold text-accent"
                    : "text-text hover:bg-surface-2 hover:text-text"
                }`}
                aria-current={active ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>
