---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/escalas", label: "Escalas" },
  { href: "/acordes", label: "Acordes" },
  { href: "/conceptos", label: "Conceptos" },
];
---

<nav class="sticky top-0 z-40 border-b border-slate-800 bg-slate-900/80 backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-bold text-slate-100">
      <span class="text-amber-400">◍</span> Círculo de Quintas
    </a>
    <ul class="flex items-center gap-1 text-sm">
      {
        links.map((l) => {
          const active = path === l.href;
          return (
            <li>
              <a
                href={l.href}
                class={`rounded-lg px-3 py-1.5 transition ${
                  active
                    ? "bg-amber-500/15 font-semibold text-amber-300"
                    : "text-slate-300 hover:bg-slate-800 hover:text-slate-100"
                }`}
                aria-current={active ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>
