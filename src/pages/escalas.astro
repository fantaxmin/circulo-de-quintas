---
import Layout from "../layouts/Layout.astro";
import ScalesExplorer from "../components/ScalesExplorer.tsx";
---

<Layout title="Escalas · Círculo de Quintas">
  <main class="mx-auto flex max-w-4xl flex-col gap-8 px-4 py-10">
    <header class="text-center">
      <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">Escalas</h1>
      <p class="mt-2 text-muted">
        Elige una tónica y un tipo de escala para ver sus notas, escucharla y
        verla resaltada en el teclado.
      </p>
    </header>

    <ScalesExplorer client:load />
  </main>
</Layout>
