---
import Layout from "../layouts/Layout.astro";
import ChordExplorer from "../components/ChordExplorer.tsx";
---

<Layout title="Acordes · Círculo de Quintas">
  <main class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-10">
    <header class="text-center">
      <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">Acordes</h1>
      <p class="mt-2 text-muted">
        Compara cómo suenan los distintos tipos de acorde: mayor, menor,
        disminuido, aumentado, suspendidos, séptimas, novena y más.
      </p>
    </header>

    <ChordExplorer client:load />
  </main>
</Layout>
