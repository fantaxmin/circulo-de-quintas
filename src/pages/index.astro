---
import Layout from "../layouts/Layout.astro";
import App from "../components/App.tsx";
---

<Layout>
  <main class="mx-auto flex max-w-3xl flex-col items-center gap-8 px-4 py-10">
    <header class="text-center">
      <h1 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
        Círculo de Quintas
      </h1>
      <p class="mt-2 text-slate-400">
        Explora tonalidades, escucha sus acordes, modos y progresiones.
      </p>
    </header>

    <App client:load />
  </main>
</Layout>
